{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveSprite Companion",
  "version": "1.0.0",
  "identifier": "app.livesprite.companion",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pairing",
        "title": "Pair LiveSprite Companion",
        "url": "index.html",
        "width": 440,
        "height": 430,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icon.icns", "icon.ico"],
    "shortDescription": "Global hotkeys for LiveSprite",
    "longDescription": "Registers project hotkeys and forwards them to an active LiveSprite session."
  }
}
